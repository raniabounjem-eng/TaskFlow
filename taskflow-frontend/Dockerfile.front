# ── Dockerfile Frontend Angular ──────────────────────────────────────────────
# Multi-stage build :
#   Stage 1 (build)  : ng build >> génère les fichiers statiques dans /dist
#   Stage 2 (runtime): Nginx sert les fichiers statiques

# ─── Stage 1 : Build Angular ─────────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
#RUN npm install --quiet

COPY . .
RUN npm run build

# ─── Stage 2 : Nginx ─────────────────────────────────────────────────────────
FROM nginx:alpine

# Copier les fichiers buildés
COPY --from=build /app/dist/taskflow-frontend /usr/share/nginx/html

# Config Nginx pour le routing Angular (SPA)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# Health check (utilisé par docker-compose)
HEALTHCHECK --interval=15s --timeout=5s \
  CMD wget -qO- http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
